# Copy to .env and fill in. Never commit .env.

# --- LLM ---
# mock | anthropic | openai | azure_openai | bedrock | gemini
LLM_PROVIDER=mock
ANTHROPIC_API_KEY=
LLM_MODEL=claude-sonnet-5-5
LLM_FAST_MODEL=claude-haiku-5-5
LLM_ROUTING=true

# Other providers (only if you switch LLM_PROVIDER)
OPENAI_API_KEY=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_ENDPOINT=
AWS_REGION=eu-west-1
GEMINI_API_KEY=

# --- Embeddings ---
# hashing (offline, CI) | fastembed (local, recommended for demos) | voyage | openai
EMBEDDING_PROVIDER=hashing
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
VOYAGE_API_KEY=

# --- Vector store ---
# memory | faiss | chroma | pgvector | pinecone
VECTOR_STORE=memory
PG_DSN=postgresql://hcai:hcai@localhost:5433/hcai
PINECONE_API_KEY=

# --- Retrieval & guardrails ---
RETRIEVAL_MODE=hybrid
TOP_K=5
CHUNKING=section
PATIENT_SCOPING=true
# Recalibrate with `python -m hcai.eval.calibrate` whenever EMBEDDING_PROVIDER changes
ABSTAIN_MIN_SCORE=0.27
REDACT_PHI_IN_LOGS=true

# Protects POST /ingest
ADMIN_TOKEN=change-me
